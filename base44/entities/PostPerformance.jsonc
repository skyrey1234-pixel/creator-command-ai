{
  "name": "PostPerformance",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "tiktok",
        "youtube",
        "other"
      ],
      "default": "instagram"
    },
    "content_title": {
      "type": "string"
    },
    "post_url": {
      "type": "string"
    },
    "posted_at": {
      "type": "string",
      "format": "date"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "shares": {
      "type": "number",
      "default": 0
    },
    "saves": {
      "type": "number",
      "default": 0
    },
    "completion_rate": {
      "type": "number",
      "default": 0
    },
    "followers_gained": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "instagram"
      ],
      "default": "manual"
    },
    "performance_score": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "wins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_test": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "content_title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}