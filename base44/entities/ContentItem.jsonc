{
  "name": "ContentItem",
  "type": "object",
  "properties": {
    "day": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "reel",
        "carousel",
        "story",
        "post",
        "live"
      ]
    },
    "title": {
      "type": "string"
    },
    "concept": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "cta": {
      "type": "string"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "best_time": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "content_pillar": {
      "type": "string"
    },
    "generation_id": {
      "type": "string"
    },
    "publish_date": {
      "type": "string",
      "format": "date"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "tiktok",
        "youtube",
        "other"
      ],
      "default": "instagram"
    },
    "scheduled_time": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved"
      ],
      "default": "draft"
    },
    "external_post_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "scheduled",
        "posted"
      ],
      "default": "idea"
    }
  },
  "required": [
    "day",
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}