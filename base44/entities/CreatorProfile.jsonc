{
  "name": "CreatorProfile",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string"
    },
    "niche": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    },
    "visual_style": {
      "type": "string"
    },
    "favorite_phrases": {
      "type": "string"
    },
    "goals": {
      "type": "string"
    },
    "products": {
      "type": "string"
    },
    "boundaries": {
      "type": "string"
    },
    "audience_description": {
      "type": "string"
    },
    "follower_count": {
      "type": "number"
    },
    "avg_views": {
      "type": "number"
    },
    "engagement_rate": {
      "type": "number"
    },
    "primary_platforms": {
      "type": "string"
    },
    "tone_tags": {
      "type": "string"
    },
    "value_proposition": {
      "type": "string"
    },
    "content_pillars": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "monetization_goal": {
      "type": "string"
    },
    "posting_frequency": {
      "type": "string"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "brand_name",
    "niche"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}