{
  "name": "ReelProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "idea": {
      "type": "string"
    },
    "content_item_id": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "opening": {
      "type": "string"
    },
    "spoken_script": {
      "type": "string"
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shot_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "b_roll": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "on_screen_text": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caption": {
      "type": "string"
    },
    "music_style": {
      "type": "string"
    },
    "thumbnail_idea": {
      "type": "string"
    },
    "video_length": {
      "type": "string"
    },
    "cta": {
      "type": "string"
    },
    "production_notes": {
      "type": "string"
    },
    "viral_score": {
      "type": "number"
    },
    "score_hook": {
      "type": "number"
    },
    "score_pacing": {
      "type": "number"
    },
    "score_clarity": {
      "type": "number"
    },
    "score_emotion": {
      "type": "number"
    },
    "score_shareability": {
      "type": "number"
    },
    "score_audience_fit": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "posted"
      ],
      "default": "draft"
    }
  },
  "required": [
    "title",
    "idea"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}