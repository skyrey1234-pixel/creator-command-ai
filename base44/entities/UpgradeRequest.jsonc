{
  "name": "UpgradeRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "requested_plan": {
      "type": "string",
      "enum": [
        "pro",
        "studio"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "contacted",
        "converted",
        "closed"
      ],
      "default": "pending"
    },
    "source": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "requested_plan"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}